<Page
    x:Class="Mapna.Sender.Views.Pages.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Mapna.Sender.ViewModels"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource AppFont}"
    Title="داده‌های مبدأ"
    d:DataContext="{d:DesignInstance vm:ExplorerViewModel}"
    mc:Ignorable="d">

    <Grid Margin="28,12,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="داده‌های مبدأ" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource Caption}"
                    Text="نمای فقط‌خواندنی جدول PERSONEL_Sender همراه با نتیجه‌ی اعتبارسنجی هر رکورد، پیش از هر ارسالی." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button
                    Height="36"
                    Margin="0,0,8,0"
                    Command="{Binding ExportCommand}"
                    Content="خروجی CSV"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button
                    Height="36"
                    Appearance="Primary"
                    Command="{Binding LoadCommand}"
                    Content="بارگذاری مجدد"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="کل رکوردهای مبدأ" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource KpiValue}" Text="{Binding TotalCount, Converter={StaticResource Number}}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="رکوردهای نامعتبر (ارسال نمی‌شوند)" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{StaticResource FailedBrush}"
                        Style="{StaticResource KpiValue}"
                        Text="{Binding InvalidCount, Converter={StaticResource Number}}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="نمایش داده‌شده" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource KpiValue}" Text="{Binding VisibleCount, Converter={StaticResource Number}}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Padding="0" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,14,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="1"
                            Width="320"
                            Margin="0,0,14,0"
                            ClearButtonEnabled="True"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="جستجو: شناسه، نام، کد ملی یا موبایل…"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:ToggleSwitch
                            Grid.Column="2"
                            Content="فقط نامعتبرها"
                            IsChecked="{Binding ShowInvalidOnly}" Checked="ToggleSwitch_Checked" />
                    </Grid>

                    <ui:DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding RowsView}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                        Style="{StaticResource ResultsGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:SymbolIcon x:Name="Icon" FontSize="18" Foreground="{StaticResource SentBrush}" Symbol="CheckmarkCircle24" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle24" />
                                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource FailedBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="90" Binding="{Binding Record.PerId}" Header="شناسه" />
                            <DataGridTextColumn Width="1.4*" Binding="{Binding FullName}" Header="نام و نام خانوادگی" />
                            <DataGridTextColumn Width="120" Binding="{Binding Record.NationalCode}" Header="کد ملی" />
                            <DataGridTextColumn Width="120" Binding="{Binding Record.MobileNo}" Header="موبایل" />
                            <DataGridTextColumn Width="1.2*" Binding="{Binding Record.PerEmail}" Header="ایمیل" />
                            <DataGridTextColumn Width="2*" Binding="{Binding ErrorSummary}" Header="خطاهای اعتبارسنجی">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource FailedBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding ErrorSummary}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </ui:DataGrid>

                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Body}" Text="در حال خواندن از پایگاه‌داده مبدأ…" />
                    </StackPanel>

                    <ui:InfoBar
                        Grid.Row="1"
                        Margin="18"
                        VerticalAlignment="Top"
                        IsClosable="False"
                        IsOpen="{Binding HasLoadError, Mode=OneWay}"
                        Message="{Binding LoadError}"
                        Severity="Error"
                        FlowDirection="RightToLeft"
                        FontFamily="{StaticResource AppFont}"
                        Title="خطا" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Style="{StaticResource DetailPanel}"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,10,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="رکورد مبدأ" />
                            <TextBlock
                                FontSize="19"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Selected.FullName}" />
                        </StackPanel>
                        <ui:Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseDetailCommand}"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Padding="20,0,20,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding Selected.Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:InfoBar
                                            Margin="0,0,0,6"
                                            IsClosable="False"
                                            IsOpen="True"
                                            Message="{Binding}"
                                            Severity="Error"
                                            FlowDirection="RightToLeft"
                                            FontFamily="{StaticResource AppFont}"
                                            Title="نامعتبر" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemTemplate="{StaticResource FieldRowTemplate}" ItemsSource="{Binding SelectedFields}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
