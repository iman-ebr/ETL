<Page
    x:Class="Mapna.Sender.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Mapna.Sender.ViewModels"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource AppFont}"
    Title="تاریخچه"
    d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
    mc:Ignorable="d">

    <Grid Margin="28,12,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="تاریخچه اجراها" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="۵۰ اجرای اخیر و نتیجه‌ی تک‌تک رکوردها در هر اجرا" />
            </StackPanel>
            <ui:Button
                Grid.Column="1"
                Height="36"
                Command="{Binding RefreshCommand}"
                Content="رفرش"
                Icon="{ui:SymbolIcon ArrowClockwise24}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="6" Style="{StaticResource Surface}">
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Runs}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedRun, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RunSummary}">
                            <Grid Margin="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,0,12,0" Fill="{StaticResource TotalBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding StartedText}" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" />
                                        <TextBlock Margin="8,0,0,0" Style="{StaticResource Caption}" Text="{Binding Run.MachineName}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CountsText}" />
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Numeric}" Text="{Binding DurationText}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource FailedBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Padding="0" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,14,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="رکوردهای اجرا" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight"
                                FontFamily="{StaticResource MonoFont}"
                                Style="{StaticResource Caption}"
                                Text="{Binding SelectedRun.Run.RunId}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="همه" GroupName="HistoryFilter" IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" Style="{StaticResource SegmentButton}" />
                                <RadioButton Content="ارسال‌شده" GroupName="HistoryFilter" IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Sent}" Style="{StaticResource SegmentButton}" />
                                <RadioButton Content="بدون تغییر" GroupName="HistoryFilter" IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Duplicate}" Style="{StaticResource SegmentButton}" />
                                <RadioButton Content="ناموفق" GroupName="HistoryFilter" IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Failed}" Style="{StaticResource SegmentButton}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ui:DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding ItemsView}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        Style="{StaticResource ResultsGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="96" Binding="{Binding PerId}" Header="شناسه" />
                            <DataGridTextColumn Width="1.3*" Binding="{Binding PersonName}" Header="نام و نام خانوادگی" />
                            <DataGridTemplateColumn Width="140" CellTemplate="{StaticResource StatusCellTemplate}" Header="وضعیت" />
                            <DataGridTextColumn Width="1.2*" Binding="{Binding ChangedFieldsText}" Header="فیلدهای تغییرکرده" />
                            <DataGridTextColumn Width="2*" Binding="{Binding ReasonText}" Header="توضیح">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding ReasonText}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="70" Binding="{Binding AttemptCount}" Header="دفعات" />
                            <DataGridTextColumn Width="90" Binding="{Binding TimeText}" Header="زمان" />
                        </DataGrid.Columns>
                    </ui:DataGrid>

                    <Border
                        Grid.Row="2"
                        Padding="18,10"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding Detail, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Detail.Item.PersonName}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Body}" Text="{Binding Detail.Item.ReasonText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
