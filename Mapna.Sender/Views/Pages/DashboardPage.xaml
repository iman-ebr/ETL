<Page
    x:Class="Mapna.Sender.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Mapna.Sender.ViewModels"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource AppFont}"
    Title="داشبورد"
    d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1240"
    mc:Ignorable="d">

    <Grid Margin="28,12,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
        </Grid.RowDefinitions>

        <!--  ============================== Header  ==============================  -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="داشبورد همگام‌سازی" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Border
                        x:Name="StateChip"
                        Padding="10,4,12,4"
                        AutomationProperties.AutomationId="StateChip"
                        CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource TotalSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateSeverity}" Value="Success">
                                        <Setter Property="Background" Value="{StaticResource SentSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateSeverity}" Value="Warning">
                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateSeverity}" Value="Error">
                                        <Setter Property="Background" Value="{StaticResource FailedSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="15" Symbol="{Binding StateSymbol}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding StateText}" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Caption}"
                        Text="{Binding PhaseText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ui:Button
                    Height="38"
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="RetryEnvironment"
                    Command="{Binding CheckEnvironmentCommand}"
                    Content="بررسی مجدد اتصال"
                    Icon="{ui:SymbolIcon ArrowClockwise24}"
                    Visibility="{Binding ShowEnvironmentRetry, Converter={StaticResource BoolToVis}}" />
                <ui:ProgressRing
                    Width="22"
                    Height="22"
                    Margin="0,0,12,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsCheckingEnvironment, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    MinWidth="168"
                    Height="38"
                    Appearance="Primary"
                    AutomationProperties.AutomationId="StartSync"
                    Command="{Binding StartCommand}"
                    Content="شروع همگام‌سازی"
                    Icon="{ui:SymbolIcon Play24}"
                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    MinWidth="120"
                    Height="38"
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="PauseSync"
                    Command="{Binding PauseCommand}"
                    Content="توقف موقت"
                    Icon="{ui:SymbolIcon Pause24}"
                    Visibility="{Binding ShowPauseButton, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    MinWidth="120"
                    Height="38"
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    AutomationProperties.AutomationId="ContinueSync"
                    Command="{Binding ContinueCommand}"
                    Content="ادامه"
                    Icon="{ui:SymbolIcon Play24}"
                    Visibility="{Binding ShowContinueButton, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    MinWidth="110"
                    Height="38"
                    Appearance="Danger"
                    AutomationProperties.AutomationId="StopSync"
                    Command="{Binding StopCommand}"
                    Content="توقف"
                    Icon="{ui:SymbolIcon Stop24}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <!--  ============================== Banners  ==============================  -->
        <StackPanel Grid.Row="1">
            <ui:InfoBar
                Margin="0,0,0,14"
                IsClosable="True"
                IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                Message="{Binding BannerMessage}"
                Severity="{Binding BannerSeverity}"
                FlowDirection="RightToLeft"
                FontFamily="{StaticResource AppFont}"
                Title="{Binding BannerTitle}" />

            <Border
                Margin="0,0,0,14"
                AutomationProperties.AutomationId="ResumeOffer"
                BorderBrush="{StaticResource WarningBrush}"
                Style="{StaticResource Surface}"
                Visibility="{Binding ShowResumeOffer, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Background="{StaticResource WarningSoftBrush}"
                        Style="{StaticResource KpiIconBadge}"
                        VerticalAlignment="Center">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{StaticResource WarningBrush}"
                            Symbol="History24" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="یک اجرای ناتمام پیدا شد" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Body}"
                            Text="{Binding ResumableSummary}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Primary"
                            AutomationProperties.AutomationId="ResumePrevious"
                            Command="{Binding ResumePreviousCommand}"
                            Content="ادامه‌ی همان اجرا"
                            Icon="{ui:SymbolIcon ArrowRepeatAll24}" />
                        <ui:Button
                            AutomationProperties.AutomationId="DiscardPrevious"
                            Command="{Binding DiscardPreviousCommand}"
                            Content="نادیده گرفتن"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!--  ============================== KPI cards  ==============================  -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Total  -->
            <Border Grid.Column="0" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="کل رکوردها" />
                        <TextBlock
                            Margin="0,6,0,2"
                            AutomationProperties.AutomationId="KpiTotal"
                            Style="{StaticResource KpiValue}"
                            Text="{Binding Total, Converter={StaticResource Number}}" />
                        <TextBlock Style="{StaticResource Numeric}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Share}">
                                    <Binding Path="Processed" />
                                    <Binding Path="Total" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Background="{StaticResource TotalSoftBrush}"
                        Style="{StaticResource KpiIconBadge}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{StaticResource TotalBrush}"
                            Symbol="People24" />
                    </Border>
                </Grid>
            </Border>

            <!--  Sent  -->
            <Border Grid.Column="2" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="ارسال‌شده" />
                        <TextBlock
                            Margin="0,6,0,2"
                            AutomationProperties.AutomationId="KpiSent"
                            Style="{StaticResource KpiValue}"
                            Text="{Binding SentCount, Converter={StaticResource Number}}" />
                        <TextBlock Style="{StaticResource Numeric}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Share}">
                                    <Binding Path="SentCount" />
                                    <Binding Path="Processed" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Background="{StaticResource SentSoftBrush}"
                        Style="{StaticResource KpiIconBadge}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{StaticResource SentBrush}"
                            Symbol="CloudSync24" />
                    </Border>
                </Grid>
            </Border>

            <!--  Duplicate  -->
            <Border Grid.Column="4" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="بدون تغییر" />
                        <TextBlock
                            Margin="0,6,0,2"
                            AutomationProperties.AutomationId="KpiDuplicate"
                            Style="{StaticResource KpiValue}"
                            Text="{Binding DuplicateCount, Converter={StaticResource Number}}" />
                        <TextBlock Style="{StaticResource Numeric}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Share}">
                                    <Binding Path="DuplicateCount" />
                                    <Binding Path="Processed" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Background="{StaticResource DuplicateSoftBrush}"
                        Style="{StaticResource KpiIconBadge}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{StaticResource DuplicateBrush}"
                            Symbol="DocumentCopy24" />
                    </Border>
                </Grid>
            </Border>

            <!--  Failed  -->
            <Border Grid.Column="6" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="ناموفق / نامعتبر" />
                        <TextBlock
                            Margin="0,6,0,2"
                            AutomationProperties.AutomationId="KpiFailed"
                            Style="{StaticResource KpiValue}"
                            Text="{Binding FailedCount, Converter={StaticResource Number}}" />
                        <TextBlock Style="{StaticResource Numeric}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Share}">
                                    <Binding Path="FailedCount" />
                                    <Binding Path="Processed" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Background="{StaticResource FailedSoftBrush}"
                        Style="{StaticResource KpiIconBadge}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{StaticResource FailedBrush}"
                            Symbol="ErrorCircle24" />
                    </Border>
                </Grid>
            </Border>

            <!--  Throughput  -->
            <Border Grid.Column="8" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="سرعت (رکورد/ثانیه)" />
                        <TextBlock
                            Margin="0,6,0,2"
                            Style="{StaticResource KpiValue}"
                            Text="{Binding Throughput, Converter={StaticResource Number}, ConverterParameter=0.0}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Caption}" Text="زمان باقی‌مانده: " />
                            <TextBlock Style="{StaticResource Numeric}" Text="{Binding EtaText}" />
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Background="{StaticResource SpeedSoftBrush}"
                        Style="{StaticResource KpiIconBadge}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{StaticResource SpeedBrush}"
                            Symbol="TopSpeed24" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  ============================== Progress + charts  ==============================  -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="پیشرفت اجرا" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Processed, Converter={StaticResource Number}}" />
                            <TextBlock
                                Margin="4,0"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="از" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Total, Converter={StaticResource Number}}" />
                            <TextBlock
                                Margin="14,0,0,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Style="{StaticResource Numeric}"
                                Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar
                        Grid.Row="1"
                        Height="8"
                        Margin="0,12,0,10"
                        AutomationProperties.AutomationId="RunProgress"
                        IsIndeterminate="{Binding IsPreparing}"
                        Maximum="100"
                        Value="{Binding ProgressPercent, Mode=OneWay}" />

                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" Text="نرخ پردازش در طول زمان (رکورد بر ثانیه)" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,4,0"
                                FontSize="14"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Symbol="Timer24" />
                            <TextBlock Style="{StaticResource Caption}" Text="زمان سپری‌شده: " />
                            <TextBlock Style="{StaticResource Numeric}" Text="{Binding ElapsedText}" />
                        </StackPanel>
                    </Grid>

                    <lvc:CartesianChart Background="Transparent"
                        Grid.Row="3"
                        AnimationsSpeed="00:00:00.250"
                        FlowDirection="LeftToRight"
                        Series="{Binding ThroughputSeries}"
                        TooltipPosition="Hidden"
                        XAxes="{Binding XAxes}"
                        YAxes="{Binding YAxes}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="توزیع نتایج" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="180" Height="180">
                            <lvc:PieChart Background="Transparent"
                                AnimationsSpeed="00:00:00.300"
                                FlowDirection="LeftToRight"
                                InitialRotation="-90"
                                LegendPosition="Hidden"
                                Series="{Binding StatusSeries}"
                                TooltipPosition="Hidden"
                                Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />
                            <Ellipse
                                Width="150"
                                Height="150"
                                Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                StrokeDashArray="3 3"
                                StrokeThickness="2"
                                Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Processed, Converter={StaticResource Number}}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Caption}"
                                    Text="پردازش‌شده" />
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource SentBrush}" />
                                <TextBlock Grid.Column="1" Margin="8,0" Style="{StaticResource Body}" Text="ارسال‌شده" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SentCount, Converter={StaticResource Number}}" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource DuplicateBrush}" />
                                <TextBlock Grid.Column="1" Margin="8,0" Style="{StaticResource Body}" Text="بدون تغییر" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding DuplicateCount, Converter={StaticResource Number}}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource FailedBrush}" />
                                <TextBlock Grid.Column="1" Margin="8,0" Style="{StaticResource Body}" Text="ناموفق" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding FailedCount, Converter={StaticResource Number}}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  ============================== Results + detail panel  ==============================  -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Padding="0" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,14,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="نتایج رکوردها" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="8,1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="9">
                                <TextBlock
                                    AutomationProperties.AutomationId="VisibleCount"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding VisibleCount, Converter={StaticResource Number}}" />
                            </Border>
                        </StackPanel>

                        <ui:TextBox
                            Grid.Column="2"
                            Width="260"
                            Margin="0,0,10,0"
                            AutomationProperties.AutomationId="ResultsSearch"
                            ClearButtonEnabled="True"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="جستجو: شناسه، نام یا دلیل…"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <Border
                            Grid.Column="3"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    AutomationProperties.AutomationId="FilterAll"
                                    Content="همه"
                                    GroupName="ResultFilter"
                                    IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumEquals}, ConverterParameter=All}"
                                    Style="{StaticResource SegmentButton}" />
                                <RadioButton
                                    AutomationProperties.AutomationId="FilterSent"
                                    Content="ارسال‌شده"
                                    GroupName="ResultFilter"
                                    IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Sent}"
                                    Style="{StaticResource SegmentButton}" />
                                <RadioButton
                                    AutomationProperties.AutomationId="FilterDuplicate"
                                    Content="بدون تغییر"
                                    GroupName="ResultFilter"
                                    IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Duplicate}"
                                    Style="{StaticResource SegmentButton}" />
                                <RadioButton
                                    AutomationProperties.AutomationId="FilterFailed"
                                    Content="ناموفق"
                                    GroupName="ResultFilter"
                                    IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Failed}"
                                    Style="{StaticResource SegmentButton}" />
                            </StackPanel>
                        </Border>

                        <ui:Button
                            Grid.Column="4"
                            Height="34"
                            AutomationProperties.AutomationId="ExportResults"
                            Command="{Binding ExportCommand}"
                            Content="خروجی CSV"
                            Icon="{ui:SymbolIcon ArrowDownload24}" />
                    </Grid>

                    <ui:DataGrid
                        x:Name="ResultsGrid"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="ResultsGrid"
                        ItemsSource="{Binding ResultsView}"
                        SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                        Style="{StaticResource ResultsGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="64"
                                Binding="{Binding Sequence}"
                                Header="#" />
                            <DataGridTextColumn
                                Width="96"
                                Binding="{Binding PerId}"
                                Header="شناسه" />
                            <DataGridTextColumn
                                Width="1.3*"
                                Binding="{Binding PersonName}"
                                Header="نام و نام خانوادگی" />
                            <DataGridTemplateColumn
                                Width="140"
                                CellTemplate="{StaticResource StatusCellTemplate}"
                                Header="وضعیت"
                                SortMemberPath="Status" />
                            <DataGridTextColumn
                                Width="1.2*"
                                Binding="{Binding ChangedFieldsText}"
                                Header="فیلدهای تغییرکرده" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding ReasonText}"
                                Header="توضیح">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding ReasonText}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding TimeText}"
                                Header="زمان" />
                        </DataGrid.Columns>
                    </ui:DataGrid>

                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding VisibleCount, Converter={StaticResource ZeroToVis}}">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="44"
                            Foreground="{DynamicResource TextFillColorDisabledBrush}"
                            Symbol="DocumentTable24" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Body}"
                            Text="نتیجه‌ای برای نمایش وجود ندارد" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource Caption}"
                            Text="با شروع همگام‌سازی، وضعیت هر رکورد اینجا به‌صورت زنده نمایش داده می‌شود." />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Detail panel  -->
            <Border
                Grid.Column="1"
                AutomationProperties.AutomationId="DetailPanel"
                Style="{StaticResource DetailPanel}"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,16,10,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="جزئیات رکورد" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Detail.Item.PersonName}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <ContentControl Content="{Binding Detail.Item}" ContentTemplate="{StaticResource StatusCellTemplate}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Caption}"
                                    Text="{Binding Detail.Item.PerId, StringFormat=شناسه پرسنلی {0}}" />
                            </StackPanel>
                        </StackPanel>
                        <ui:Button
                            Width="34"
                            Height="34"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Appearance="Transparent"
                            AutomationProperties.AutomationId="CloseDetail"
                            BorderThickness="0"
                            Command="{Binding CloseDetailCommand}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            ToolTip="بستن" />
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        Padding="20,0,20,12"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ui:InfoBar
                                Margin="0,0,0,14"
                                IsClosable="False"
                                IsOpen="{Binding Detail.HasReason, Mode=OneWay}"
                                Message="{Binding Detail.Item.ReasonText}"
                                Severity="{Binding Detail.ReasonSeverity}"
                                FlowDirection="RightToLeft"
                                FontFamily="{StaticResource AppFont}"
                                Title="{Binding Detail.ReasonTitle}" />

                            <StackPanel Margin="0,0,0,14" Visibility="{Binding Detail.HasChanges, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource SectionTitle}"
                                    Text="فیلدهای تغییرکرده نسبت به آخرین ارسال موفق" />
                                <ItemsControl ItemsSource="{Binding Detail.Item.ChangedFieldLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock
                                Margin="0,0,0,6"
                                Style="{StaticResource SectionTitle}"
                                Text="محتوای رکورد"
                                Visibility="{Binding Detail.HasFields, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemTemplate="{StaticResource FieldRowTemplate}" ItemsSource="{Binding Detail.Fields}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Row="2"
                        Padding="20,10"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight"
                                FontFamily="{StaticResource MonoFont}"
                                Style="{StaticResource Caption}"
                                Text="{Binding Detail.Item.CorrelationId, StringFormat=correlation {0}}"
                                ToolTip="شناسه‌ی ردیابی مشترک در SendLogs و ReceiveLogs" />
                            <ui:Button
                                Grid.Column="1"
                                Command="{Binding CopyDetailJsonCommand}"
                                Content="کپی JSON"
                                Icon="{ui:SymbolIcon Copy24}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
