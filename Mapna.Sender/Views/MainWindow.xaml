<ui:FluentWindow
    x:Class="Mapna.Sender.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Mapna.Sender.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Mapna.Sender.ViewModels"
    Title="{Binding ApplicationTitle}"
    Width="1480"
    Height="940"
    MinWidth="1180"
    MinHeight="720"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource AppFont}"
    Icon="pack://application:,,,/Assets/app.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Title bar stays LeftToRight on purpose: WPF-UI's caption buttons implement Windows 11 snap layouts through
            hit-testing, and mirroring them is not something we want to discover is broken in front of the client.
        -->
        <ui:TitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            Title="{Binding ApplicationTitle}"
            CloseWindowByDoubleClickOnIcon="True"
            FlowDirection="LeftToRight">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <ui:Button
                    x:Name="ThemeToggleButton"
                    Width="40"
                    Height="32"
                    Margin="0,0,4,0"
                    Padding="0"
                    Appearance="Transparent"
                    AutomationProperties.AutomationId="ThemeToggle"
                    BorderThickness="0"
                    Command="{Binding ToggleThemeCommand}"
                    ToolTip="تغییر پوسته (روشن / تیره)">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding ThemeSymbol}" />
                    </ui:Button.Icon>
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="236"
            PaneDisplayMode="Left">
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="14,6,14,14" Orientation="Horizontal">
                    <Image
                        Width="30"
                        Height="30"
                        Source="pack://application:,,,/Assets/app.png" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="همگام‌سازی پرسنل" />
                        <TextBlock Style="{StaticResource Caption}" Text="Mapna Personnel Sync" />
                    </StackPanel>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="NavDashboard"
                    Content="داشبورد همگام‌سازی"
                    Icon="{ui:SymbolIcon DataHistogram24}"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="NavExplorer"
                    Content="داده‌های مبدأ"
                    Icon="{ui:SymbolIcon TableSearch24}"
                    TargetPageType="{x:Type pages:ExplorerPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="NavHistory"
                    Content="تاریخچه اجراها"
                    Icon="{ui:SymbolIcon History24}"
                    TargetPageType="{x:Type pages:HistoryPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="NavSettings"
                    Content="تنظیمات"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" FlowDirection="RightToLeft" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:ContentDialogHost
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
