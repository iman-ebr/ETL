<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Mapna.Sender.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!--  Converters  -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:NullToVisibilityConverter x:Key="NotNullToCollapsed" Invert="True" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    <conv:ZeroToVisibilityConverter x:Key="NonZeroToVis" Invert="True" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
    <conv:NumberConverter x:Key="Number" />
    <conv:ShareConverter x:Key="Share" />

    <!--  Status palette (fixed hues that read well on both themes; used by badges, KPI icons and chart series)  -->
    <SolidColorBrush x:Key="SentBrush" Color="#10B981" />
    <SolidColorBrush x:Key="DuplicateBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="FailedBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="TotalBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="SpeedBrush" Color="#A855F7" />
    <SolidColorBrush x:Key="SentSoftBrush" Color="#10B981" Opacity="0.16" />
    <SolidColorBrush x:Key="DuplicateSoftBrush" Color="#94A3B8" Opacity="0.18" />
    <SolidColorBrush x:Key="FailedSoftBrush" Color="#EF4444" Opacity="0.16" />
    <SolidColorBrush x:Key="TotalSoftBrush" Color="#3B82F6" Opacity="0.16" />
    <SolidColorBrush x:Key="SpeedSoftBrush" Color="#A855F7" Opacity="0.16" />
    <SolidColorBrush x:Key="ChangedFieldBrush" Color="#3B82F6" Opacity="0.12" />

    <!--  Surfaces & typography  -->
    <Style x:Key="Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Numbers/percentages are laid out LTR so "42.5%" is not bidi-reordered to "%42.5"; Left = visual start in the RTL parent  -->
    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Numeric" TargetType="TextBlock">
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#F59E0B" Opacity="0.18" />

    <!--  KPI icon badge: rounded square with a soft tinted background  -->
    <Style x:Key="KpiIconBadge" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!--  Status pill used in every results grid, bound to a RecordResultItem  -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="9,2,10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource DuplicateSoftBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Sent">
                <Setter Property="Background" Value="{StaticResource SentSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="ValidationFailed">
                <Setter Property="Background" Value="{StaticResource FailedSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="SendFailed">
                <Setter Property="Background" Value="{StaticResource FailedSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource DuplicateBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Sent">
                <Setter Property="Fill" Value="{StaticResource SentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="ValidationFailed">
                <Setter Property="Fill" Value="{StaticResource FailedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="SendFailed">
                <Setter Property="Fill" Value="{StaticResource FailedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="StatusCellTemplate">
        <Border Style="{StaticResource StatusPill}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusDot}" />
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding StatusText}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--  Segmented control built from RadioButtons  -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Chrome"
                        Margin="2"
                        Padding="12,5"
                        Background="Transparent"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentHost" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="1" />
    </Style>

    <!--  Chip used for changed-field names  -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChangedFieldBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <!--  Side detail panel slide-in  -->
    <Style x:Key="DetailPanel" TargetType="Border" BasedOn="{StaticResource Surface}">
        <Setter Property="Width" Value="400" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Visibility" Value="Visible">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-24" To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  One label/value row of the detail panel; changed fields get an accent background  -->
    <DataTemplate x:Key="FieldRowTemplate">
        <Border x:Name="Row" Padding="10,7" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="12.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Label}" />
                    <Border
                        x:Name="ChangedTag"
                        Margin="6,0,0,0"
                        Padding="5,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource TotalBrush}"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <TextBlock FontSize="10" Foreground="White" Text="تغییر" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Value}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{StaticResource ChangedFieldBrush}" />
                <Setter TargetName="ChangedTag" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Shared DataGrid look: virtualized, read-only, calm row separators  -->
    <Style x:Key="ResultsGrid" TargetType="ui:DataGrid" BasedOn="{StaticResource {x:Type ui:DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="RowHeight" Value="38" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>
