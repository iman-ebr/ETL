<UserControl
    x:Class="WebService.Sender.Views.Dialogs.RunReportDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WebService.Sender.ViewModels"
    Width="780"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource AppFont}"
    d:DataContext="{d:DesignInstance vm:RunReportViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Headline  -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Headline}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource Caption}"
                Text="{Binding RunLabel}" />
        </StackPanel>

        <!--  Counters  -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12,10" Background="{StaticResource TotalSoftBrush}" CornerRadius="8">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="کل رکوردها" />
                    <TextBlock Margin="0,2,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TotalBrush}" Text="{Binding Total, Converter={StaticResource Number}}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="12,10" Background="{StaticResource SentSoftBrush}" CornerRadius="8">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ارسال‌شده" />
                    <TextBlock Margin="0,2,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SentBrush}" Text="{Binding SentCount, Converter={StaticResource Number}}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Padding="12,10" Background="{StaticResource DuplicateSoftBrush}" CornerRadius="8">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="بدون تغییر" />
                    <TextBlock Margin="0,2,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DuplicateBrush}" Text="{Binding DuplicateCount, Converter={StaticResource Number}}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Padding="12,10" Background="{StaticResource FailedSoftBrush}" CornerRadius="8">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ارسال‌نشده / ناموفق" />
                    <TextBlock Margin="0,2,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource FailedBrush}" Text="{Binding OutstandingCount, Converter={StaticResource Number}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Reason groups  -->
        <ItemsControl Grid.Row="2" Margin="0,0,0,4" ItemsSource="{Binding Categories}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CategoryCount}">
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Text}" />
                            <TextBlock Margin="6,0,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Count, Converter={StaticResource Number}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Per-record reasons  -->
        <ui:DataGrid
            Grid.Row="3"
            MaxHeight="300"
            MinRowHeight="38"
            ItemsSource="{Binding Rows}"
            RowHeight="NaN"
            Style="{StaticResource ResultsGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="84" Binding="{Binding PerId}" Header="شناسه" />
                <DataGridTextColumn Width="150" Binding="{Binding PersonName}" Header="نام و نام خانوادگی" />
                <DataGridTextColumn Width="130" Binding="{Binding CategoryText}" Header="نوع مشکل" />
                <DataGridTemplateColumn Width="*" Header="دلیل ارسال نشدن">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:OutstandingRow}">
                            <TextBlock
                                Margin="0,6"
                                VerticalAlignment="Center"
                                Text="{Binding Message}"
                                TextWrapping="Wrap"
                                ToolTip="{Binding Advice}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <!--  Notes  -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock
                Foreground="{StaticResource WarningBrush}"
                Text="{Binding SourceFixWarning}"
                TextWrapping="Wrap"
                Visibility="{Binding HasSourceFixWarning, Converter={StaticResource BoolToVis}}" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource Caption}"
                Text="{Binding ResolvedLaterText}"
                TextWrapping="Wrap"
                Visibility="{Binding HasResolvedLater, Converter={StaticResource BoolToVis}}" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource Caption}"
                Text="ارسال مجدد فقط همین رکوردها را می‌فرستد؛ رکوردهای موفق دوباره ارسال نمی‌شوند."
                TextWrapping="Wrap"
                Visibility="{Binding OutstandingCount, Converter={StaticResource NonZeroToVis}}" />
        </StackPanel>

        <ui:Button
            Grid.Row="5"
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Command="{Binding ExportCommand}"
            Content="خروجی CSV"
            Icon="{ui:SymbolIcon ArrowDownload24}"
            Visibility="{Binding OutstandingCount, Converter={StaticResource NonZeroToVis}}" />
    </Grid>
</UserControl>
